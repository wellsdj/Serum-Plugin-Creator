# Optional. The easiest way to add keys is the Settings tab on the web page (they're saved
# in data/secrets.json). Keys put here override that. Copy this file to .env to use it.

# Free key from https://console.groq.com/keys (speech-to-text and the brain)
GROQ_API_KEY=
# Key from https://elevenlabs.io/app/settings/api-keys (the voice; the free plan works)
ELEVENLABS_API_KEY=

# BUDDY_PORT=8000
# BUDDY_LOG=INFO
